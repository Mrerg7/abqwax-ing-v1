---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found — ABQWax.ing"
  description="This page does not exist on ABQWax.ing. Return to the Albuquerque waxing domain offering."
  canonical="/404"
  robots="noindex, follow"
>
  <Header />
  <main class="flex-1">
    <section class="section-padding bg-ink-950">
      <div class="container-narrow max-w-2xl text-center">
        <p class="text-[11px] font-medium uppercase tracking-widestx text-gold-400">404</p>
        <h1 class="mt-3 font-display text-4xl font-semibold text-white sm:text-5xl">Page not found</h1>
        <p class="mt-4 text-sm leading-relaxed text-ink-100/80 sm:text-base">
          That URL is not part of the site. Head back to the domain offering or explore the Albuquerque waxing guides.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <a href="/" class="btn-primary">Back to home</a>
          <a href="/albuquerque-waxing/" class="btn-secondary">Albuquerque waxing guide</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
