---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const insights = (await getCollection('insights'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Waxing Insights — ABQWax.ing"
  description="Practical guides on Albuquerque waxing, hard wax vs soft wax, Brazilian prep, and aftercare — from the team behind the ABQWax.ing domain."
  canonical="/insights/"
  keywords="Albuquerque waxing guide, hard wax vs soft wax, Brazilian wax tips, waxing aftercare, ABQWax.ing"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Insights', path: '/insights/' },
  ]}
>
  <Header />

  <main class="flex-1">
    <section class="border-b border-ink-100 bg-ink-950">
      <div class="container-narrow py-16 sm:py-24">
        <p class="text-[11px] font-medium uppercase tracking-widestx text-gold-400">Insights · Waxing · Education</p>
        <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight text-white sm:text-6xl">
          Waxing insights, from Albuquerque
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-100/85 sm:text-lg">
          Practical, no-fluff guides on the category the ABQWax<span class="italic text-gold-300">.ing</span> domain was built to lead.
        </p>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-narrow">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {insights.map((post) => (
            <a
              href={`/insights/${post.slug}/`}
              class="card group flex flex-col transition hover:-translate-y-1"
            >
              <p class="text-[11px] font-medium uppercase tracking-widestx text-gold-500">
                {post.data.pubDate.toISOString().split('T')[0]}
              </p>
              <h2 class="mt-3 font-display text-2xl font-semibold text-ink-950 group-hover:text-gold-500">
                {post.data.title}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-ink-700">{post.data.description}</p>
              <span class="mt-4 text-sm font-medium text-gold-500">Read more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
